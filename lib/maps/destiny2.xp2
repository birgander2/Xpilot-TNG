<Option name="edgewrap" value="yes"/>
<Option name="maxitemdensity" value="0.00001"/>
<Option name="teamassign" value="no"/>
<Option name="teamimmunity" value="yes"/>
<Option name="itemenergypackprob" value="40.01323e-09"/>
<Option name="itemtankprob" value="20.40292e-09"/>
<Option name="itemecmprob" value="60.92426e-09"/>

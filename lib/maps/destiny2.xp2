<Option name="allowshields" value="no"/>
<Option name="roguemineprob" value="0"/>
<Option name="rogueheatprob" value="0"/>
<Option name="reportToMetaServer" value="yes"/>
<Option name="mapwidth" value="7000"/>
<Option name="mapheight" value="7000"/>

// Windows resources shared by all XPilot TNG executables (configured by CMake)
#include <winver.h>

1 ICON "@XP_WIN_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName",     "XPilot TNG"
            VALUE "FileDescription", "XPilot TNG multiplayer space war game"
            VALUE "FileVersion",     "@PROJECT_VERSION@"
            VALUE "ProductVersion",  "@PROJECT_VERSION@"
            VALUE "LegalCopyright",  "GNU General Public License v2 or later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
